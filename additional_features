-- A) SOS Alerts
CREATE TABLE IF NOT EXISTS emergency_alert (
  alert_id BIGSERIAL PRIMARY KEY,
  user_id TEXT NOT NULL REFERENCES "user"(user_id) ON DELETE CASCADE,
  thana_id TEXT REFERENCES thana(thana_id),
  location_text TEXT,
  latitude NUMERIC(10, 7),
  longitude NUMERIC(10, 7),
  severity TEXT NOT NULL DEFAULT 'high'
    CHECK (severity IN ('medium', 'high', 'critical')),
  status TEXT NOT NULL DEFAULT 'open'
    CHECK (status IN ('open', 'assigned', 'closed')),
  assigned_officer_id TEXT REFERENCES officer(officer_id),
  incident_summary TEXT,
  response_notes TEXT,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  closed_at TIMESTAMPTZ
);

CREATE INDEX IF NOT EXISTS idx_emergency_alert_status ON emergency_alert(status);
CREATE INDEX IF NOT EXISTS idx_emergency_alert_thana ON emergency_alert(thana_id);
CREATE INDEX IF NOT EXISTS idx_emergency_alert_created ON emergency_alert(created_at DESC);

-- B) National Command Room (chat + signaling)
CREATE TABLE IF NOT EXISTS command_room (
  room_id BIGSERIAL PRIMARY KEY,
  room_code TEXT UNIQUE NOT NULL,
  title TEXT NOT NULL,
  created_by TEXT NOT NULL,
  thana_id TEXT REFERENCES thana(thana_id),
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS command_room_member (
  room_id BIGINT NOT NULL REFERENCES command_room(room_id) ON DELETE CASCADE,
  member_id TEXT NOT NULL,
  role_in_room TEXT NOT NULL DEFAULT 'participant' CHECK (role_in_room IN ('host','participant','observer')),
  joined_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  PRIMARY KEY (room_id, member_id)
);

CREATE TABLE IF NOT EXISTS command_room_message (
  message_id BIGSERIAL PRIMARY KEY,
  room_id BIGINT NOT NULL REFERENCES command_room(room_id) ON DELETE CASCADE,
  sender_id TEXT NOT NULL,
  sender_role TEXT,
  message TEXT NOT NULL,
  message_type TEXT NOT NULL DEFAULT 'text' CHECK (message_type IN ('text','alert','system')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_command_room_message_room_time
  ON command_room_message(room_id, created_at DESC);

CREATE TABLE IF NOT EXISTS call_signal (
  signal_id BIGSERIAL PRIMARY KEY,
  room_id BIGINT NOT NULL REFERENCES command_room(room_id) ON DELETE CASCADE,
  from_member_id TEXT NOT NULL,
  to_member_id TEXT,
  signal_type TEXT NOT NULL CHECK (signal_type IN ('offer','answer','ice')),
  payload JSONB NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  consumed BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE INDEX IF NOT EXISTS idx_call_signal_room_consumed
  ON call_signal(room_id, consumed, created_at);
