  try {
    const res = await axiosInstance.post(`/additional/command-room/signal/${roomId}`, payload);
    return res.data;
  } catch {
    return { success: false };
  }
}

export async function pullSignals(roomId) {
  try {
    const res = await axiosInstance.get(`/additional/command-room/signal/${roomId}`);
    return res.data;
  } catch {
    return { success: false, data: [] };
  }
}
