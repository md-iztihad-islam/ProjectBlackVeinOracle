import pool from "../config/dbConnection.js";

const roomCode = () => `CR-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;

// ---------- Improvement: GD duplicate check + SLA ----------
export const findSimilarGDRepository = async ({ userId, description }) => {
  const query = `
    SELECT gd_id, description, status, submitted_at
    FROM gd_report
    WHERE user_id = $1
      AND submitted_at >= NOW() - INTERVAL '7 days'
      AND similarity(lower(description), lower($2)) > 0.35
    ORDER BY submitted_at DESC
    LIMIT 10;
  `;
  const result = await pool.query(query, [userId, description]);
  return result.rows;
};

export const getSLABreachRepository = async () => {
  const query = `
    SELECT
      COUNT(*) FILTER (WHERE status='submitted' AND submitted_at < NOW() - INTERVAL '12 hours') AS submitted_breach,
      COUNT(*) FILTER (WHERE status='assigned' AND submitted_at < NOW() - INTERVAL '48 hours') AS assigned_breach
    FROM gd_report;
  `;
  const result = await pool.query(query);
  return result.rows[0];
};

// ---------- SOS ----------
export const createSOSRepository = async (data) => {
  const {
    user_id,
    thana_id,
    location_text,
    latitude,
    longitude,
    severity,
    incident_summary,
  } = data;

  const query = `
    INSERT INTO emergency_alert
      (user_id, thana_id, location_text, latitude, longitude, severity, incident_summary)
    VALUES
      ($1, $2, $3, $4, $5, $6, $7)
    RETURNING *;
  `;

  const values = [
    user_id,
    thana_id || null,
    location_text || null,
    latitude || null,
    longitude || null,
    severity || "high",
    incident_summary || null,
  ];

  const result = await pool.query(query, values);
  return result.rows[0];
};

export const listSOSRepository = async ({ status, thanaId }) => {
  let query = `
    SELECT ea.*, u.full_name AS user_name, o.full_name AS assigned_officer_name
    FROM emergency_alert ea
    LEFT JOIN "user" u ON ea.user_id = u.user_id
    LEFT JOIN officer o ON ea.assigned_officer_id = o.officer_id
    WHERE 1=1
  `;
  const values = [];

  if (status) {
    values.push(status);
    query += ` AND ea.status = $${values.length}`;
  }
  if (thanaId) {
    values.push(thanaId);
    query += ` AND ea.thana_id = $${values.length}`;
  }

  query += ` ORDER BY ea.created_at DESC LIMIT 200;`;

  const result = await pool.query(query, values);
  return result.rows;
};

export const assignSOSRepository = async ({ alertId, officerId }) => {
  const query = `
    UPDATE emergency_alert
    SET status='assigned', assigned_officer_id=$1
    WHERE alert_id=$2
    RETURNING *;
  `;
  const result = await pool.query(query, [officerId, alertId]);
  return result.rows[0];
};

export const closeSOSRepository = async ({ alertId, responseNotes }) => {
  const query = `
    UPDATE emergency_alert
    SET status='closed', response_notes=$1, closed_at=NOW()
    WHERE alert_id=$2
    RETURNING *;
  `;
  const result = await pool.query(query, [responseNotes || null, alertId]);
  return result.rows[0];
};

// ---------- Command Room ----------
export const createCommandRoomRepository = async ({ title, createdBy, thanaId }) => {
  const code = roomCode();
  const query = `
    INSERT INTO command_room (room_code, title, created_by, thana_id)
    VALUES ($1, $2, $3, $4)
    RETURNING *;
  `;
  const result = await pool.query(query, [code, title, createdBy, thanaId || null]);

  const room = result.rows[0];
  await pool.query(
    `INSERT INTO command_room_member (room_id, member_id, role_in_room) VALUES ($1, $2, 'host') ON CONFLICT DO NOTHING`,
    [room.room_id, createdBy],
  );

  return room;
};

export const joinCommandRoomRepository = async ({ roomId, memberId }) => {
  await pool.query(
    `INSERT INTO command_room_member (room_id, member_id, role_in_room)
     VALUES ($1, $2, 'participant')
     ON CONFLICT DO NOTHING`,
    [roomId, memberId],
  );

  const room = await pool.query(`SELECT * FROM command_room WHERE room_id=$1`, [roomId]);
  return room.rows[0] || null;
};

export const sendCommandRoomMessageRepository = async ({ roomId, senderId, senderRole, message, messageType }) => {
  const query = `
    INSERT INTO command_room_message (room_id, sender_id, sender_role, message, message_type)
    VALUES ($1, $2, $3, $4, $5)
    RETURNING *;
  `;
  const result = await pool.query(query, [roomId, senderId, senderRole || null, message, messageType || "text"]);
  return result.rows[0];
};

export const listCommandRoomMessagesRepository = async (roomId) => {
  const query = `
    SELECT *
    FROM command_room_message
    WHERE room_id = $1
    ORDER BY created_at ASC
    LIMIT 500;
  `;
  const result = await pool.query(query, [roomId]);
  return result.rows;
};

export const pushCallSignalRepository = async ({ roomId, fromMemberId, toMemberId, signalType, payload }) => {
  const query = `
    INSERT INTO call_signal (room_id, from_member_id, to_member_id, signal_type, payload)
    VALUES ($1, $2, $3, $4, $5::jsonb)
    RETURNING *;
  `;
  const result = await pool.query(query, [roomId, fromMemberId, toMemberId || null, signalType, JSON.stringify(payload || {})]);
  return result.rows[0];
};

export const pullCallSignalsRepository = async ({ roomId, memberId }) => {
  const query = `
    WITH picked AS (
      SELECT signal_id
      FROM call_signal
      WHERE room_id = $1
        AND consumed = FALSE
        AND (to_member_id IS NULL OR to_member_id = $2)
      ORDER BY created_at ASC
      LIMIT 100
    )
    UPDATE call_signal cs
    SET consumed = TRUE
    FROM picked
    WHERE cs.signal_id = picked.signal_id
    RETURNING cs.*;
  `;
  const result = await pool.query(query, [roomId, memberId]);
  return result.rows;
};
```

