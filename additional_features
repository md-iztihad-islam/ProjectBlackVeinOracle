## 3.3 National Command Room page (chat + signaling skeleton)

**Create New File:** `Frontend/src/pages/Dashboard/Officer/NationalCommandRoom.jsx`

```jsx
import { useEffect, useState } from "react";
import {
  createCommandRoom,
  joinCommandRoom,
  getCommandRoomMessages,
  sendCommandRoomMessage,
  pullSignals,
} from "@/services/Additional/additionalFeaturesApi";

function NationalCommandRoom() {
  const [roomId, setRoomId] = useState("");
  const [title, setTitle] = useState("Rapid Response Coordination");
  const [messages, setMessages] = useState([]);
  const [text, setText] = useState("");

  const loadMessages = async (rid) => {
    const r = await getCommandRoomMessages(rid);
    if (r.success) setMessages(r.data || []);
  };

  const onCreate = async () => {
    const r = await createCommandRoom({ title });
    if (r.success) {
      const rid = String(r.data.room_id);
      setRoomId(rid);
      await loadMessages(rid);
    } else alert(r.message || "Failed");
  };

  const onJoin = async () => {
    if (!roomId) return;
    const r = await joinCommandRoom(roomId);
    if (r.success) await loadMessages(roomId);
    else alert(r.message || "Failed");
  };

  const onSend = async () => {
    if (!roomId || !text.trim()) return;
    const r = await sendCommandRoomMessage(roomId, text.trim(), "text");
    if (r.success) {
      setText("");
      await loadMessages(roomId);
    }
  };

  useEffect(() => {
    if (!roomId) return;
    const timer = setInterval(async () => {
      await loadMessages(roomId);
      await pullSignals(roomId); // placeholder for future WebRTC hookup
    }, 3000);
    return () => clearInterval(timer);
  }, [roomId]);

  return (
    <div className="min-h-screen bg-gray-950 text-slate-100 p-6">
      <div className="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div className="lg:col-span-1 bg-gray-900 border border-white/10 rounded-xl p-4">
          <h2 className="text-xl font-bold mb-4">National Command Room</h2>
          <input
            className="w-full bg-gray-800 border border-white/10 rounded-lg px-3 py-2 mb-2"
            placeholder="Room title"
            value={title}
            onChange={(e) => setTitle(e.target.value)}
          />
          <button onClick={onCreate} className="w-full bg-blue-600 hover:bg-blue-500 rounded-lg py-2 mb-3">
            Create Command Room
          </button>

          <input
            className="w-full bg-gray-800 border border-white/10 rounded-lg px-3 py-2 mb-2"
            placeholder="Room ID"
            value={roomId}
            onChange={(e) => setRoomId(e.target.value)}
          />
          <button onClick={onJoin} className="w-full bg-emerald-600 hover:bg-emerald-500 rounded-lg py-2">
            Join Room
          </button>
        </div>

        <div className="lg:col-span-2 bg-gray-900 border border-white/10 rounded-xl p-4 flex flex-col h-[70vh]">
          <h3 className="font-semibold mb-3">Live Coordination Feed</h3>
          <div className="flex-1 overflow-y-auto space-y-2 pr-2">
            {messages.map((m) => (
              <div key={m.message_id} className="bg-gray-800 rounded-lg px-3 py-2">
                <div className="text-xs text-slate-400 mb-1">
                  {m.sender_role || "member"} • {new Date(m.created_at).toLocaleTimeString()}
                </div>
                <div>{m.message}</div>
              </div>
            ))}
          </div>

          <div className="mt-3 flex gap-2">
            <input
              className="flex-1 bg-gray-800 border border-white/10 rounded-lg px-3 py-2"
              placeholder="Type coordination update..."
              value={text}
              onChange={(e) => setText(e.target.value)}
            />
            <button onClick={onSend} className="bg-blue-600 hover:bg-blue-500 px-4 rounded-lg">
              Send
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}

export default NationalCommandRoom;
```

